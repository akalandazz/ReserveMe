# Скопируйте этот файл в .env и впишите свои значения.
#
# Переменные читаются Vite ТОЛЬКО с префиксом VITE_ и подставляются
# на этапе сборки — после правки нужен пересбор: npm run build.

# Адрес проекта Supabase: Settings → API → Project URL.
VITE_SUPABASE_URL=https://ВАШ_ПРОЕКТ.supabase.co

# Публичный ключ: Settings → API → Project API keys → anon public.
#
# Это НЕ секрет: ключ уезжает в собранный бандл, и его видит любой
# пользователь приложения. Данные защищает не он, а RLS в базе —
# см. supabase/schema.sql. Ключ service_role сюда вписывать НЕЛЬЗЯ.
VITE_SUPABASE_ANON_KEY=

# Как часто (в секундах) открытое приложение перечитывает данные, пока
# оно на экране. Необязательно: пусто или не число — 20.
# Мини-апп клиента: цены, график, занятость, статусы своих заявок.
VITE_CLIENT_POLL_SECONDS=20
# Кабинет мастера: новые заявки и отмены клиентов.
VITE_ADMIN_POLL_SECONDS=20
