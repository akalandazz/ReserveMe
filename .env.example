# Переменные читаются Vite ТОЛЬКО с префиксом VITE_ и подставляются
# на этапе сборки — после правки нужен пересбор: npm run build.

# Telegram-логин мастера БЕЗ символа @.
# Если не задать — возьмётся значение по умолчанию из src/data.js.
VITE_MASTER_USERNAME=vladislava_beauty
